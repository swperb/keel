// expect: E-SPEC
fn tri(n: i64) -> i64
  requires 0 <= n && n <= 100
{
  var s: i64 = 0;
  var i: i64 = 0;
  while i < n invariant 0 <= i && i <= n && 0 <= s && s <= 100 * i decreases n - i { s = s + i; i = i + 1; }
  return s;
}
fn f(n: i64) -> i64
  requires 0 <= n && n <= 100
  ensures result == tri(n)
{
  return tri(n);
}
