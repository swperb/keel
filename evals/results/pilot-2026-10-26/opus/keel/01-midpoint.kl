fn floor_half(a: i64) -> i64
  ensures (2 * result) <= a && a < (2 * result) + 2
{
  let q: i64 = a / 2;
  if (a % 2) < 0 {
    return q - 1;
  }
  return q;
}

fn midpoint(a: i64, b: i64) -> i64
  ensures (2 * result) <= a + b && a + b < (2 * result) + 2
{
  let fa: i64 = floor_half(a);
  let fb: i64 = floor_half(b);
  if (a % 2) != 0 && (b % 2) != 0 {
    return fa + fb + 1;
  }
  return fa + fb;
}
