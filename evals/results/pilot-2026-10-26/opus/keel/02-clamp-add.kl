spec fn clampv(s: i64, lo: i64, hi: i64) -> i64 {
  if s < lo { lo } else { if s > hi { hi } else { s } }
}

fn clamp_add(a: i64, b: i64, lo: i64, hi: i64) -> i64
  requires lo <= hi
  ensures result == clampv(a + b, lo, hi)
{
  if b >= 0 {
    if a > 9223372036854775807 - b {
      return hi;
    }
  } else {
    if a < -9223372036854775808 - b {
      return lo;
    }
  }
  let s: i64 = a + b;
  if s < lo {
    return lo;
  }
  if s > hi {
    return hi;
  }
  return s;
}
