struct Vend { credit: i64, stock: i64, sold: i64 }
enum Ev { Coin { v: i64 }, Buy { price: i64 }, Refund, Restock { n: i64 } }

fn step(m: Vend, e: Ev) -> Vend
  requires 0 <= m.credit && m.credit <= 1_000_000
  requires 0 <= m.stock && m.stock <= 100
  requires 0 <= m.sold && m.sold <= 1_000_000_000
  ensures 0 <= result.credit && result.credit <= 1_000_000
  ensures 0 <= result.stock && result.stock <= 100
  ensures 0 <= result.sold && result.sold <= 1_000_000_000
{
  match e {
    Ev.Coin(c) => {
      if c.v > 0 && c.v <= 1_000_000 - m.credit {
        return Vend { credit: m.credit + c.v, stock: m.stock, sold: m.sold };
      }
      return m;
    }
    Ev.Buy(b) => {
      if b.price > 0 && m.stock > 0 && m.credit >= b.price && m.sold < 1_000_000_000 {
        return Vend { credit: m.credit - b.price, stock: m.stock - 1, sold: m.sold + 1 };
      }
      return m;
    }
    Ev.Refund => {
      return Vend { credit: 0, stock: m.stock, sold: m.sold };
    }
    Ev.Restock(r) => {
      if r.n > 0 {
        if r.n >= 100 - m.stock {
          return Vend { credit: m.credit, stock: 100, sold: m.sold };
        }
        return Vend { credit: m.credit, stock: m.stock + r.n, sold: m.sold };
      }
      return m;
    }
  }
}
