fn union(a: &[i64], b: &[i64], out: &mut [i64]) -> i64
  requires len(a) <= 1_000_000
  requires len(b) <= 1_000_000
  requires len(out) == len(a) + len(b)
  requires forall x in 0..len(a) { forall y in 0..len(a) { x <= y ==> a[x] <= a[y] } }
  requires forall x in 0..len(b) { forall y in 0..len(b) { x <= y ==> b[x] <= b[y] } }
  ensures 0 <= result && result <= len(out)
  ensures forall k in 0..result { forall m in 0..result { k < m ==> out[k] < out[m] } }
  ensures forall k in 0..result { (exists m in 0..len(a) { a[m] == out[k] }) || (exists m in 0..len(b) { b[m] == out[k] }) }
  ensures forall m in 0..len(a) { exists k in 0..result { out[k] == a[m] } }
  ensures forall m in 0..len(b) { exists k in 0..result { out[k] == b[m] } }
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  var i: i64 = 0;
  var j: i64 = 0;
  var r: i64 = 0;
  while i < na || j < nb
    invariant 0 <= i && i <= na
    invariant 0 <= j && j <= nb
    invariant 0 <= r && r <= i + j
    invariant len(out) == na + nb
    invariant len(a) == na
    invariant len(b) == nb
    invariant forall k in 0..r { forall m in 0..r { k < m ==> out[k] < out[m] } }
    invariant forall k in 0..r { (exists m in 0..i { a[m] == out[k] }) || (exists m in 0..j { b[m] == out[k] }) }
    invariant forall m in 0..i { exists k in 0..r { out[k] == a[m] } }
    invariant forall m in 0..j { exists k in 0..r { out[k] == b[m] } }
    invariant r > 0 ==> (i < na ==> out[r - 1] <= a[i])
    invariant r > 0 ==> (j < nb ==> out[r - 1] <= b[j])
    invariant forall x in 0..na { forall y in 0..na { x <= y ==> a[x] <= a[y] } }
    invariant forall x in 0..nb { forall y in 0..nb { x <= y ==> b[x] <= b[y] } }
    decreases (na - i) + (nb - j)
  {
    var v: i64 = 0;
    if i < na && j < nb {
      if a[i] <= b[j] {
        v = a[i];
      } else {
        v = b[j];
      }
    } else if i < na {
      v = a[i];
    } else {
      v = b[j];
    }
    if r == 0 {
      out[r] = v;
      r = r + 1;
    } else if out[r - 1] != v {
      out[r] = v;
      r = r + 1;
    }
    if i < na && a[i] == v {
      i = i + 1;
    }
    if j < nb && b[j] == v {
      j = j + 1;
    }
  }
  return r;
}
