fn union(a: &[i64], b: &[i64], out: &mut [i64]) -> i64
  requires len(a) <= 1_000_000 && len(b) <= 1_000_000
  requires len(out) == len(a) + len(b)
  requires forall i in 0..(len(a) - 1) { a[i] <= a[i + 1] }
  requires forall i in 0..(len(b) - 1) { b[i] <= b[i + 1] }
  ensures len(out) == len(a) + len(b)
  ensures 0 <= result && result <= len(out)
  ensures forall t in 0..(result - 1) { out[t] < out[t + 1] }
  ensures forall x in 0..len(a) { exists t in 0..result { out[t] == a[x] } }
  ensures forall x in 0..len(b) { exists t in 0..result { out[t] == b[x] } }
{
  let na: i64 = len(a);
  let nb: i64 = len(b);
  var i: i64 = 0;
  var j: i64 = 0;
  var w: i64 = 0;
  while i < na || j < nb
    invariant 0 <= i && i <= na && 0 <= j && j <= nb
    invariant 0 <= w && w <= i + j
    invariant len(out) == na + nb
    invariant (w == 0) == (i + j == 0)
    invariant (w > 0 && i < na) ==> out[w - 1] <= a[i]
    invariant (w > 0 && j < nb) ==> out[w - 1] <= b[j]
    invariant forall t in 0..(w - 1) { out[t] < out[t + 1] }
    invariant forall x in 0..i { exists t in 0..w { out[t] == a[x] } }
    invariant forall x in 0..j { exists t in 0..w { out[t] == b[x] } }
    decreases (na + nb) - (i + j)
  {
    var v: i64 = 0;
    if j >= nb {
      v = a[i];
      i = i + 1;
    } else if i >= na {
      v = b[j];
      j = j + 1;
    } else if a[i] <= b[j] {
      v = a[i];
      i = i + 1;
    } else {
      v = b[j];
      j = j + 1;
    }
    if w == 0 {
      out[w] = v;
      w = w + 1;
    } else if out[w - 1] != v {
      out[w] = v;
      w = w + 1;
    }
  }
  return w;
}
