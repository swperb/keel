fn dedup(xs: &mut [i64], orig: &[i64]) -> i64
  requires len(orig) == len(xs)
  requires len(xs) <= 1_000_000
  requires forall i in 0..len(xs) { orig[i] == xs[i] }
  requires forall i in 0..(len(orig) - 1) { orig[i] <= orig[i + 1] }
  ensures len(xs) == len(orig)
  ensures 0 <= result && result <= len(xs)
  ensures forall t in 0..(result - 1) { xs[t] < xs[t + 1] }
  ensures forall j in 0..len(orig) { exists t in 0..result { xs[t] == orig[j] } }
  ensures forall t in 0..result { exists j in 0..len(orig) { xs[t] == orig[j] } }
{
  let n: i64 = len(xs);
  let pos: [i64] = array(n, 0);
  let src: [i64] = array(n, 0);
  var w: i64 = 0;
  var i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant 0 <= w && w <= i
    invariant n == len(xs) && n == len(orig) && n == len(pos) && n == len(src)
    invariant (i == 0) == (w == 0)
    invariant i > 0 ==> xs[w - 1] == orig[i - 1]
    invariant forall t in 0..(w - 1) { xs[t] < xs[t + 1] }
    invariant forall j in 0..i { 0 <= pos[j] && pos[j] < w && xs[pos[j]] == orig[j] }
    invariant forall t in 0..w { 0 <= src[t] && src[t] < i && xs[t] == orig[src[t]] }
    decreases n - i
  {
    if i == 0 {
      xs[w] = orig[i];
      src[w] = i;
      w = w + 1;
    } else if orig[i] != orig[i - 1] {
      xs[w] = orig[i];
      src[w] = i;
      w = w + 1;
    }
    pos[i] = w - 1;
    i = i + 1;
  }
  return w;
}
