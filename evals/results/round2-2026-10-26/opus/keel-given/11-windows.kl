spec fn total(xs: &[i64], n: i64) -> i64
  requires 0 <= n && n <= len(xs)
  decreases n
{
  if n == 0 { 0 } else { total(&xs, n - 1) + xs[n - 1] }
}

lemma total_bound(xs: &[i64], n: i64)
  requires 0 <= n && n <= len(xs)
  requires forall k in 0..len(xs) { -1_000_000_000 <= xs[k] && xs[k] <= 1_000_000_000 }
  ensures 0 - (n * 1_000_000_000) <= total(&xs, n) && total(&xs, n) <= n * 1_000_000_000
  decreases n
{
  if n > 0 {
    total_bound(&xs, n - 1);
  }
}

fn prefix(xs: &[i64], pre: &mut [i64])
  requires len(xs) <= 1_000_000
  requires forall k in 0..len(xs) { -1_000_000_000 <= xs[k] && xs[k] <= 1_000_000_000 }
  requires len(pre) == len(xs) + 1
  ensures forall k in 0..len(pre) { pre[k] == total(&xs, k) }
{
  let n: i64 = len(xs);
  pre[0] = 0;
  var i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant len(pre) == n + 1
    invariant 0 - (i * 1_000_000_000) <= pre[i] && pre[i] <= i * 1_000_000_000
    invariant forall k in 0..(i + 1) { pre[k] == total(&xs, k) }
    decreases n - i
  {
    pre[i + 1] = pre[i] + xs[i];
    i = i + 1;
  }
}

fn range_sum(xs: &[i64], pre: &[i64], lo: i64, hi: i64) -> i64
  requires len(xs) <= 1_000_000
  requires forall k in 0..len(xs) { -1_000_000_000 <= xs[k] && xs[k] <= 1_000_000_000 }
  requires len(pre) == len(xs) + 1
  requires forall k in 0..len(pre) { pre[k] == total(&xs, k) }
  requires 0 <= lo && lo <= hi && hi <= len(xs)
  ensures result == total(&xs, hi) - total(&xs, lo)
{
  total_bound(&xs, hi);
  total_bound(&xs, lo);
  return pre[hi] - pre[lo];
}

fn best_window(xs: &[i64], w: i64) -> i64
  requires len(xs) <= 1_000_000
  requires forall k in 0..len(xs) { -1_000_000_000 <= xs[k] && xs[k] <= 1_000_000_000 }
  ensures (w < 1 || w > len(xs)) ==> result == -9223372036854775808
  ensures (1 <= w && w <= len(xs)) ==> exists s in 0..((len(xs) - w) + 1) { result == total(&xs, s + w) - total(&xs, s) }
  ensures (1 <= w && w <= len(xs)) ==> forall s in 0..((len(xs) - w) + 1) { result >= total(&xs, s + w) - total(&xs, s) }
{
  if w < 1 || w > len(xs) {
    return -9223372036854775808;
  }
  let n: i64 = len(xs);
  let pre: [i64] = array(n + 1, 0);
  prefix(&xs, &mut pre);
  total_bound(&xs, w);
  var best: i64 = pre[w] - pre[0];
  var bi: i64 = 0;
  var s: i64 = 1;
  while s <= n - w
    invariant 1 <= s && s <= (n - w) + 1
    invariant len(pre) == n + 1
    invariant forall k in 0..(n + 1) { pre[k] == total(&xs, k) }
    invariant 0 <= bi && bi < s
    invariant best == total(&xs, bi + w) - total(&xs, bi)
    invariant forall t in 0..s { best >= total(&xs, t + w) - total(&xs, t) }
    decreases ((n - w) + 1) - s
  {
    total_bound(&xs, s + w);
    total_bound(&xs, s);
    let c: i64 = pre[s + w] - pre[s];
    if c > best {
      best = c;
      bi = s;
    }
    s = s + 1;
  }
  assert exists t in 0..((n - w) + 1) { best == total(&xs, t + w) - total(&xs, t) };
  return best;
}
