fn union(a: &[i64], b: &[i64], out: &mut [i64]) -> i64
  requires len(a) <= 1_000_000 && len(b) <= 1_000_000
  requires len(out) == len(a) + len(b)
  requires forall i in 0..len(a) { forall j in i..len(a) { a[i] <= a[j] } }
  requires forall i in 0..len(b) { forall j in i..len(b) { b[i] <= b[j] } }
  ensures 0 <= result && result <= len(out)
  ensures forall s in 0..result { forall t in (s + 1)..result { out[s] < out[t] } }
  ensures forall i in 0..len(a) { exists t in 0..result { out[t] == a[i] } }
  ensures forall j in 0..len(b) { exists t in 0..result { out[t] == b[j] } }
  ensures forall t in 0..result { (exists i in 0..len(a) { a[i] == out[t] }) || (exists j in 0..len(b) { b[j] == out[t] }) }
{
  let la: i64 = len(a);
  let lb: i64 = len(b);
  var i: i64 = 0;
  var j: i64 = 0;
  var r: i64 = 0;
  while i < la || j < lb
    invariant 0 <= i && i <= la
    invariant 0 <= j && j <= lb
    invariant 0 <= r && r <= i + j
    invariant len(a) == la && len(b) == lb && len(out) == la + lb
    invariant forall s in 0..r { forall t in (s + 1)..r { out[s] < out[t] } }
    invariant forall x in 0..i { exists t in 0..r { out[t] == a[x] } }
    invariant forall y in 0..j { exists t in 0..r { out[t] == b[y] } }
    invariant forall t in 0..r { (exists q in 0..i { a[q] == out[t] }) || (exists q in 0..j { b[q] == out[t] }) }
    invariant forall t in 0..r { forall q in i..la { out[t] <= a[q] } }
    invariant forall t in 0..r { forall q in j..lb { out[t] <= b[q] } }
    decreases (la - i) + (lb - j)
  {
    var takeA: bool = false;
    if i < la {
      if j < lb {
        if a[i] <= b[j] {
          takeA = true;
        }
      } else {
        takeA = true;
      }
    }
    var v: i64 = 0;
    if takeA {
      v = a[i];
      i = i + 1;
    } else {
      v = b[j];
      j = j + 1;
    }
    if r == 0 {
      out[r] = v;
      r = r + 1;
    } else {
      if out[r - 1] != v {
        out[r] = v;
        r = r + 1;
      }
    }
  }
  return r;
}
