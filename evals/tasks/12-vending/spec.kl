struct Vend { credit: i64, stock: i64, sold: i64 }

enum Ev {
  Coin { v: i64 },
  Buy { price: i64 },
  Refund,
  Restock { n: i64 },
}

fn step(m: Vend, e: Ev) -> Vend
  requires 0 <= m.credit && m.credit <= 1_000_000
  requires 0 <= m.stock && m.stock <= 100
  requires 0 <= m.sold && m.sold <= 1_000_000_000
  ensures e is Ev.Coin ==> (((e as Ev.Coin).v > 0 && m.credit + (e as Ev.Coin).v <= 1_000_000) ==> (result.credit == m.credit + (e as Ev.Coin).v && result.stock == m.stock && result.sold == m.sold))
  ensures e is Ev.Coin ==> (!((e as Ev.Coin).v > 0 && m.credit + (e as Ev.Coin).v <= 1_000_000) ==> (result.credit == m.credit && result.stock == m.stock && result.sold == m.sold))
  ensures e is Ev.Buy ==> (((e as Ev.Buy).price > 0 && m.stock > 0 && m.credit >= (e as Ev.Buy).price && m.sold < 1_000_000_000) ==> (result.credit == m.credit - (e as Ev.Buy).price && result.stock == m.stock - 1 && result.sold == m.sold + 1))
  ensures e is Ev.Buy ==> (!((e as Ev.Buy).price > 0 && m.stock > 0 && m.credit >= (e as Ev.Buy).price && m.sold < 1_000_000_000) ==> (result.credit == m.credit && result.stock == m.stock && result.sold == m.sold))
  ensures e is Ev.Refund ==> (result.credit == 0 && result.stock == m.stock && result.sold == m.sold)
  ensures e is Ev.Restock ==> (((e as Ev.Restock).n > 0) ==> (result.credit == m.credit && result.stock == (if m.stock + (e as Ev.Restock).n > 100 { 100 } else { m.stock + (e as Ev.Restock).n }) && result.sold == m.sold))
  ensures e is Ev.Restock ==> (((e as Ev.Restock).n <= 0) ==> (result.credit == m.credit && result.stock == m.stock && result.sold == m.sold))
{
  // write the body here
}
