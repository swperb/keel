fn union(a: &[i64], b: &[i64], out: &mut [i64]) -> i64
  requires len(a) <= 1_000_000 && len(b) <= 1_000_000
  requires len(out) == len(a) + len(b)
  requires forall i in 0..len(a) { forall j in i..len(a) { a[i] <= a[j] } }
  requires forall i in 0..len(b) { forall j in i..len(b) { b[i] <= b[j] } }
  ensures 0 <= result && result <= len(out)
  ensures forall s in 0..result { forall t in (s + 1)..result { out[s] < out[t] } }
  ensures forall i in 0..len(a) { exists t in 0..result { out[t] == a[i] } }
  ensures forall j in 0..len(b) { exists t in 0..result { out[t] == b[j] } }
  ensures forall t in 0..result { (exists i in 0..len(a) { a[i] == out[t] }) || (exists j in 0..len(b) { b[j] == out[t] }) }
{
  let la: i64 = len(a);
  let lb: i64 = len(b);
  // Proof witnesses: pa[i] / pb[j] is where a[i] / b[j] landed in out;
  // from[t] is where out[t] came from (index into a, or la + index into b).
  let pa: [i64] = array(la, 0);
  let pb: [i64] = array(lb, 0);
  let from: [i64] = array(la + lb, 0);
  var i: i64 = 0;
  var j: i64 = 0;
  var w: i64 = 0;
  while i < la || j < lb
    invariant 0 <= i && i <= la && 0 <= j && j <= lb
    invariant 0 <= w && w <= i + j
    invariant forall s in 0..w { forall t in (s + 1)..w { out[s] < out[t] } }
    invariant w > 0 ==> ((i < la ==> out[w - 1] <= a[i]) && (j < lb ==> out[w - 1] <= b[j]))
    invariant forall k in 0..i { 0 <= pa[k] && pa[k] < w && out[pa[k]] == a[k] }
    invariant forall k in 0..j { 0 <= pb[k] && pb[k] < w && out[pb[k]] == b[k] }
    invariant forall t in 0..w { (0 <= from[t] && from[t] < la && a[from[t]] == out[t]) || (la <= from[t] && from[t] < la + lb && b[from[t] - la] == out[t]) }
    decreases (la - i) + (lb - j)
  {
    var v: i64 = 0;
    var src: i64 = 0;
    var takea: bool = false;
    if i < la {
      if j >= lb {
        takea = true;
      } else if a[i] <= b[j] {
        takea = true;
      }
    }
    if takea {
      v = a[i];
      src = i;
    } else {
      v = b[j];
      src = la + j;
    }
    if w == 0 || out[w - 1] != v {
      out[w] = v;
      from[w] = src;
      w = w + 1;
    }
    if takea {
      pa[i] = w - 1;
      i = i + 1;
    } else {
      pb[j] = w - 1;
      j = j + 1;
    }
  }
  return w;
}
