// Coverage for the GPU backend: every construct a par for body can use
// becomes PTX here. tests/gpu.sh runs this on a GPU and on the CPU and
// requires identical output.

// Negative division and remainder truncate toward zero, shifts, bitwise
// operators, and a short-circuit guard (i / x only when x > 0).
fn ops(x: i64, i: i64) -> i64
  requires -1000000 <= x && x <= 1000000 && 0 <= i && i <= 1000000
{
  let a: i64 = (x / 7) + (x % 7);
  let b: i64 = (i << 3) >> 1;
  var r: i64 = a + b;
  if (x > 0 && (i / x) > 2) || x == -5 {
    r = r - 1;
  }
  return ((r & 65535) | ((~i) & 65536)) ^ (x & 4095);
}

fn fill_row(row: &mut [i64], v: i64, neg: bool)
  requires 0 <= v && v <= 1000 && len(row) <= 1000
{
  var c: i64 = 0;
  while c < len(row)
    invariant 0 <= c && c <= len(row)
    decreases len(row) - c
  {
    if neg {
      row[c] = -v;
    } else {
      row[c] = v + c;
    }
    c = c + 1;
  }
}

fn kernels(xs: &[i64], out: &mut [i64], src: &[u8], d32: &mut [i32], d16: &mut [i16], d8: &mut [i8], du: &mut [u32])
  requires len(xs) <= 1000000 && len(out) == len(xs)
  requires forall k in 0..len(xs) { -1000000 <= xs[k] && xs[k] <= 1000000 }
  requires len(src) == len(xs) && len(d32) == len(xs) && len(d16) == len(xs) && len(d8) == len(xs) && len(du) == len(xs)
{
  par for i in 0..len(xs) {
    out[i] = ops(xs[i], i);
  }
  par for i in 0..len(src) {
    d32[i] = (src[i] * 1000) - 128000;
    d16[i] = wrap_i16(src[i] * 300);
    d8[i] = wrap_i8(i * 37);
    du[i] = wrap_u32(i * 2654435761);
  }
}

fn rows(m: &mut [i64], h: i64, w: i64, neg: bool)
  requires 0 <= h && h <= 1000 && 0 <= w && w <= 1000 && len(m) == h * w
{
  par for r in 0..h {
    fill_row(&mut m[r * w..(r + 1) * w], r, neg);
  }
}

fn hash64(xs: &[i64]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + xs[i]);
    i = i + 1;
  }
  return h;
}

fn hash32(xs: &[i32]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + xs[i]);
    i = i + 1;
  }
  return h;
}

fn hash16(xs: &[i16]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + xs[i]);
    i = i + 1;
  }
  return h;
}

fn hash8(xs: &[i8]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + xs[i]);
    i = i + 1;
  }
  return h;
}

fn hashu(xs: &[u32]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + xs[i]);
    i = i + 1;
  }
  return h;
}

fn fill(xs: &mut [i64])
  requires len(xs) <= 1000000
  ensures forall k in 0..len(xs) { -1000000 <= xs[k] && xs[k] <= 1000000 }
{
  par for i in 0..len(xs)
    ensures -1000000 <= xs[i] && xs[i] <= 1000000
  {
    xs[i] = ((i * 7919) % 2000001) - 1000000;
  }
}

io fn main() {
  let n: i64 = 100_000;
  let xs: [i64] = array(n, 0);
  fill(&mut xs);
  let src: [u8] = array(n, 0);
  par for i in 0..n {
    src[i] = wrap_u8(i * 7);
  }
  let out: [i64] = array(n, 0);
  let d32: [i32] = array(n, 0);
  let d16: [i16] = array(n, 0);
  let d8: [i8] = array(n, 0);
  let du: [u32] = array(n, 0);
  kernels(&xs, &mut out, &src, &mut d32, &mut d16, &mut d8, &mut du);
  print(hash64(&out));
  print(hash32(&d32));
  print(hash16(&d16));
  print(hash8(&d8));
  print(hashu(&du));
  print(out[5]);
  print(d8[100]);

  let m: [i64] = array(300 * 200, 0);
  rows(&mut m, 300, 200, false);
  print(hash64(&m));
  rows(&mut m, 300, 200, true);
  print(hash64(&m));
}
