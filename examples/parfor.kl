// Data-parallel loops. Each `par for` is proven race-free: no iteration
// touches an array slot another iteration writes. main checks every
// parallel result against a serial while loop computing the same thing.

// `rounds` steps of an LCG; stays in [0, 2^31).
fn mix(x0: i64, rounds: i64) -> i64
  requires 0 <= x0 && x0 < 2147483648 && 0 <= rounds
  ensures 0 <= result && result < 2147483648
{
  var x: i64 = x0;
  var k: i64 = 0;
  while k < rounds
    invariant 0 <= k && k <= rounds && 0 <= x && x < 2147483648
    decreases rounds - k
  {
    x = ((x * 1103515245) + 12345) % 2147483648;
    k = k + 1;
  }
  return x;
}

fn kernel(out: &mut [i64], rounds: i64)
  requires 0 <= rounds && len(out) <= 2147483648
  ensures forall k in 0..len(out) { 0 <= out[k] && out[k] < 2147483648 }
{
  par for i in 0..len(out)
    ensures 0 <= out[i] && out[i] < 2147483648
  {
    out[i] = mix(i, rounds);
  }
}

fn kernel_serial(out: &mut [i64], rounds: i64)
  requires 0 <= rounds && len(out) <= 2147483648
{
  var i: i64 = 0;
  while i < len(out)
    invariant 0 <= i && i <= len(out)
    decreases len(out) - i
  {
    out[i] = mix(i, rounds);
    i = i + 1;
  }
}

// ys[i] = a * xs[i] + ys[i], in place.
fn saxpy(a: i64, xs: &[i64], ys: &mut [i64])
  requires len(ys) == len(xs) && -1000 <= a && a <= 1000
  requires forall k in 0..len(xs) { -1000000 <= xs[k] && xs[k] <= 1000000 }
  requires forall k in 0..len(ys) { -1000000000 <= ys[k] && ys[k] <= 1000000000 }
  ensures forall k in 0..len(ys) { ys[k] == (a * xs[k]) + old(ys[k]) }
{
  par for i in 0..len(ys)
    ensures ys[i] == (a * xs[i]) + old(ys[i])
  {
    ys[i] = (a * xs[i]) + ys[i];
  }
}

fn saxpy_serial(a: i64, xs: &[i64], ys: &mut [i64])
  requires len(ys) == len(xs) && -1000 <= a && a <= 1000
  requires forall k in 0..len(xs) { -1000000 <= xs[k] && xs[k] <= 1000000 }
  requires forall k in 0..len(ys) { -1000000000 <= ys[k] && ys[k] <= 1000000000 }
{
  var i: i64 = 0;
  while i < len(ys)
    invariant 0 <= i && i <= len(ys)
    invariant forall k in i..len(ys) { ys[k] == old(ys[k]) }
    decreases len(ys) - i
  {
    ys[i] = (a * xs[i]) + ys[i];
    i = i + 1;
  }
}

// Even slots of out get xs[i], odd slots get -xs[i]: an injective scatter.
fn interleave(xs: &[i64], out: &mut [i64])
  requires len(out) == 2 * len(xs)
  requires forall k in 0..len(xs) { -1000000 <= xs[k] && xs[k] <= 1000000 }
  ensures forall k in 0..len(xs) { out[2 * k] == xs[k] && out[(2 * k) + 1] == -xs[k] }
{
  par for i in 0..len(xs)
    ensures out[2 * i] == xs[i] && out[(2 * i) + 1] == -xs[i]
  {
    out[2 * i] = xs[i];
    out[(2 * i) + 1] = -xs[i];
  }
}

fn fill(xs: &mut [i64])
  ensures forall k in 0..len(xs) { -500 <= xs[k] && xs[k] < 500 }
{
  par for i in 0..len(xs)
    ensures -500 <= xs[i] && xs[i] < 500
  {
    xs[i] = (mix(i % 2147483648, 3) % 1000) - 500;
  }
}

// Number of slots where a and b differ.
fn diff(a: &[i64], b: &[i64]) -> i64
  requires len(a) == len(b)
{
  var n: i64 = 0;
  var i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a) && 0 <= n && n <= i
    decreases len(a) - i
  {
    if a[i] != b[i] {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

// Sum of values in [-2^31, 2^31), for a printed checksum.
fn total(xs: &[i64]) -> i64
  requires len(xs) <= 1000000000
  requires forall k in 0..len(xs) { -2147483648 <= xs[k] && xs[k] < 2147483648 }
{
  var s: i64 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    invariant -2147483648 * i <= s && s <= 2147483648 * i
    decreases len(xs) - i
  {
    s = s + xs[i];
    i = i + 1;
  }
  return s;
}

io fn main() {
  let n: i64 = 1_000_000;
  let out: [i64] = array(n, 0);
  let ref: [i64] = array(n, 0);
  kernel(&mut out, 100);
  kernel_serial(&mut ref, 100);
  print(diff(&out, &ref));
  print(total(&out));

  let xs: [i64] = array(n, 0);
  fill(&mut xs);
  let ys: [i64] = array(n, 7);
  let zs: [i64] = array(n, 7);
  saxpy(3, &xs, &mut ys);
  saxpy_serial(3, &xs, &mut zs);
  print(diff(&ys, &zs));
  print(total(&ys));

  let pairs: [i64] = array(2 * n, 0);
  interleave(&xs, &mut pairs);
  print(pairs[2 * 12345]);
  print(pairs[(2 * 12345) + 1]);
}
