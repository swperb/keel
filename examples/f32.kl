// f32: IEEE single precision. The verifier proves the integer code around
// floats (indices, bounds, races, termination) but never reasons about a
// float's value, and specifications may not mention one (docs/f32.md).
// main compares each parallel result bit for bit with a serial loop.

fn saxpy(a: f32, xs: &[f32], ys: &mut [f32])
  requires len(ys) == len(xs)
{
  par for i in 0..len(ys) {
    ys[i] = (a * xs[i]) + ys[i];
  }
}

fn saxpy_serial(a: f32, xs: &[f32], ys: &mut [f32])
  requires len(ys) == len(xs)
{
  var i: i64 = 0;
  while i < len(ys)
    invariant 0 <= i && i <= len(ys)
    decreases len(ys) - i
  {
    ys[i] = (a * xs[i]) + ys[i];
    i = i + 1;
  }
}

// The logistic map x <- r x (1 - x) is chaotic: one rounding difference
// anywhere grows into a different result, so equal bits mean every
// operation rounded identically.
fn logistic(x0: f32, steps: i64) -> f32
  requires 0 <= steps
{
  var x: f32 = x0;
  var k: i64 = 0;
  while k < steps
    invariant 0 <= k && k <= steps
    decreases steps - k
  {
    x = (3.9 * x) * (1.0 - x);
    k = k + 1;
  }
  return x;
}

fn chaos(out: &mut [f32], steps: i64)
  requires 0 <= steps && len(out) <= 1000000000
{
  par for i in 0..len(out) {
    out[i] = logistic(to_f32(i + 1) / to_f32(len(out) + 2), steps);
  }
}

fn chaos_serial(out: &mut [f32], steps: i64)
  requires 0 <= steps && len(out) <= 1000000000
{
  var i: i64 = 0;
  while i < len(out)
    invariant 0 <= i && i <= len(out)
    decreases len(out) - i
  {
    out[i] = logistic(to_f32(i + 1) / to_f32(len(out) + 2), steps);
    i = i + 1;
  }
}

fn fill(xs: &mut [f32], scale: f32)
  requires len(xs) <= 1000000000
{
  par for i in 0..len(xs) {
    xs[i] = to_f32((i % 1000) - 500) * scale;
  }
}

// Slots whose bits differ.
fn diff(a: &[f32], b: &[f32]) -> i64
  requires len(a) == len(b)
{
  var n: i64 = 0;
  var i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a) && 0 <= n && n <= i
    decreases len(a) - i
  {
    if f32_bits(a[i]) != f32_bits(b[i]) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn hash(xs: &[f32]) -> i64 {
  var h: u32 = 0;
  var i: i64 = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    h = wrap_u32((h * 31) + f32_bits(xs[i]));
    i = i + 1;
  }
  return h;
}

fn specials(out: &mut [i64])
  requires len(out) == 9
{
  par for i in 0..9 {
    let zero: f32 = 0.0;
    let nan: f32 = zero / zero;
    var r: i64 = 0;
    if i == 0 {
      r = to_i64(-2.7);
    } else if i == 1 {
      r = to_i64(1.0e30);
    } else if i == 2 {
      r = to_i64(-1.0e30);
    } else if i == 3 {
      r = to_i64(nan);
    } else if i == 4 {
      r = to_i64(1.0 / zero);
    } else if i == 5 {
      r = to_i64(to_f32(16777217));
    } else if i == 6 {
      r = f32_bits(1.0);
    } else if i == 7 {
      if nan != nan {
        r = 1;
      }
    } else {
      if nan == nan || nan < nan {
        r = 1;
      }
    }
    out[i] = r;
  }
}

io fn main() {
  let n: i64 = 1_000_000;
  let xs: [f32] = array(n, 0);
  let ys: [f32] = array(n, 0);
  let zs: [f32] = array(n, 0);
  fill(&mut xs, 0.25);
  fill(&mut ys, 1.5);
  fill(&mut zs, 1.5);
  saxpy(2.5, &xs, &mut ys);
  saxpy_serial(2.5, &xs, &mut zs);
  print(diff(&ys, &zs));
  print(hash(&ys));

  let c: [f32] = array(n, 0);
  let d: [f32] = array(n, 0);
  chaos(&mut c, 200);
  chaos_serial(&mut d, 200);
  print(diff(&c, &d));
  print(hash(&c));

  // Conversions are defined for every input: toward zero, saturating,
  // NaN to 0. Computed in a par for, so on a GPU they run there.
  let conv: [i64] = array(9, 0);
  specials(&mut conv);
  var k: i64 = 0;
  while k < 9
    invariant 0 <= k && k <= 9
    decreases 9 - k
  {
    print(conv[k]);
    k = k + 1;
  }
}
